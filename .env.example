# PayPal API Configuration
# Mode: "mock" (offline test simulation), "sandbox" (PayPal Sandbox), or "live" (PayPal Production)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_CURRENCY=USD

# Organization Details for Receipts
ORG_NAME=Open Impact Foundation
ORG_EMAIL=donations@openimpact.org
ORG_TAX_ID=XX-XXXXXXX
ORG_WEBSITE=https://openimpact.org

# Database Configuration
DATABASE_PATH=storage/donations.sqlite3

# Email Service Configuration
# Mode: "mock" (writes receipts to disk/logs for offline dev) or "smtp" (dispatches real emails)
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=donations@openimpact.org
SMTP_USE_TLS=true
